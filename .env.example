# Environment Configuration for NEXUS Platform
ENVIRONMENT=development
PROJECT_NAME="NEXUS Autonomous Data Intelligence & Prediction Platform"
API_V1_STR=/api/v1
SECRET_KEY=nexus_super_secret_jwt_signing_key_change_in_production_32bytes_min!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite for instant local launch; set PostgreSQL URI for production)
DATABASE_URL=sqlite:///./nexus.db
# DATABASE_URL=postgresql+psycopg2://nexus_user:nexus_password@localhost:5432/nexus_db

# Redis Cache & Job Broker (Optional for local dev, active in Docker)
REDIS_URL=redis://localhost:6379/0

# Storage & Uploads
UPLOAD_DIR=./data/uploads
SAMPLE_DIR=./data/sample
MAX_UPLOAD_SIZE_MB=50

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Multi-Agent & LLM Configuration (Phase 5+)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexus_graph_password
